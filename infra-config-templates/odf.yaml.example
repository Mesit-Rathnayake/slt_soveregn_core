# SLTMobitel Cloud & Sovereign AI Platform - Encrypted Storage & AWS KMS (KYOK) Template
storage:
  provider: "Amazon S3 + AWS KMS Customer-Managed Key (KYOK)"
  encryption:
    enabled: true
    algorithm: "aws:kms"
    key_management: "KYOK" # Keep Your Own Key (Data Sovereignty requirement)
    enable_key_rotation: true
  buckets:
    knowledge_and_sops_bucket: "slt-mobitel-approved-manuals-prod"
    immutable_audit_trail_bucket: "slt-mobitel-governance-audit-prod"
  public_access_block:
    block_public_acls: true
    block_public_policy: true
    ignore_public_acls: true
    restrict_public_buckets: true
