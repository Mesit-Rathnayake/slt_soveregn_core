# IBM Sovereign Core v1.1.0 - Bootstrap Environment Variables
# Copy this file to 'template.env' once SLT Infrastructure keys are received.

# 1. Registry & Entitlement (Awaiting Supervisor Keys)
IBM_ENTITLEMENT_KEY="INSERT_IBM_SOVEREIGN_CORE_KEY_HERE"
SOVCORE_IMAGE="icr.io/cpopen/sovereign-cloud-platform/sovcore-install:v1.1.0"
OCP_PULL_SECRET_PATH="/home/sltadmin/pull-secret.txt"

# 2. Installer UI Settings (Runs on RHEL 10.1 Landing Zone)
INSTALL_UI_PORT=3003
NON_ROOT_USER="sltadmin"

# 3. Custom DNS Records
API_VIP="10.10.10.100"
INGRESS_VIP="10.10.20.100"