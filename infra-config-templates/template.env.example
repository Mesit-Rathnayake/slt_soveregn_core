# SLTMobitel Hybrid Cloud AI Platform - Environment Variables Template
# Copy variables to 'poc-netops-assistant/.env' to run the assistant.

# 1. SLTMobitel AWS KnowledgeBase HTTP API
SLT_KB_API_URL="https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/retrieve"
SLT_KB_AUTH_SECRET="REPLACE_WITH_SLT_KB_AUTH_SECRET"
SLT_KB_DEFAULT_TOP_K=3

# 2. AWS Bedrock & CloudFormation Settings (Replacing IBM Sovereign Core Entitlement Key)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="INSERT_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="INSERT_AWS_SECRET_ACCESS_KEY"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
AI_INFERENCE_MODE="AWS_BEDROCK"
