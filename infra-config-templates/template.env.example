# SLTMobitel Hybrid Cloud AI Platform - Environment Variables Template
# Copy variables to 'poc-netops-assistant/.env' to run the assistant.

# 1. SLTMobitel AWS KnowledgeBase HTTP API (Provided in SLTMobitel KnowledgeBase Access Api.pdf)
SLT_KB_API_URL="https://ww5659pvgk.execute-api.us-east-1.amazonaws.com/prod/retrieve"
SLT_KB_AUTH_SECRET="d215af7a649fe83938414634e789b39cb3ed4ad0a1077c2d"
SLT_KB_DEFAULT_TOP_K=3

# 2. AWS Bedrock & CloudFormation Settings (Replacing IBM Sovereign Core Entitlement Key)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="INSERT_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="INSERT_AWS_SECRET_ACCESS_KEY"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"

# 3. Local Sovereign AI Fallback (Ollama)
AI_INFERENCE_MODE="OLLAMA_LOCAL"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="granite3.1-dense:2b"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"
