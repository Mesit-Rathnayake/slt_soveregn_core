# SLTMobitel Hybrid Cloud AI Platform - Global Configuration Template (SLT Digital Labs)
# Replaces costly IBM Sovereign Core license with AWS CloudFormation + CloudFront + API Gateway + Amazon Bedrock
platform:
  organization: "SLT-Digital-Labs"
  environment: "prod"
  architecture_mode: "aws-hybrid-sovereign"
  aws_region: "us-east-1"

aws_services:
  iac_provisioning: "AWS CloudFormation (aws-cloudformation-stack.yaml)"
  edge_delivery_and_waf: "Amazon CloudFront + Origin Custom Header"
  kb_api_gateway_endpoint: "https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/retrieve"
  cloud_llm_provider: "Amazon Bedrock (anthropic.claude-3-haiku-20240307-v1:0)"
  voice_ivr_provider: "Amazon Polly Neural TTS + Amazon Connect (1212 / 1717 IVR)"

governance:
  data_residency_policy: "PII/IP Sanitization Pre-Flight before AWS API Gateway / Bedrock"
  encryption_key_management: "AWS KMS Customer-Managed Key (KYOK)"
  audit_logging_enabled: true
