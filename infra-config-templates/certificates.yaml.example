# SLTMobitel Cloud & Sovereign AI Platform - AWS Certificate Manager (ACM) & CloudFront TLS Template
tls:
  provider: "AWS Certificate Manager (ACM) + Amazon CloudFront Edge TLS"
  minimum_protocol_version: "TLSv1.2_2021"
  strict_transport_security: "max-age=63072000; includeSubDomains; preload"
  acm_certificate_region: "us-east-1"
  domain_alias: "ai-assistant.slt.lk"
  minimum_validity_days_check: 90
