AWSTemplateFormatVersion: "2010-09-09"
Description: >
  SLTMobitel Hybrid Cloud AI Platform - AWS CloudFormation Stack (Replacing Costly IBM Sovereign Core).
  Provisions Amazon CloudFront Edge Distribution (with x-auth-secret custom origin header protection),
  Amazon API Gateway HTTP API (/prod/retrieve), AWS Lambda Retrieval & Sanitization Orchestrator,
  IAM Least-Privilege Execution Role for Amazon Bedrock + KnowledgeBase, and AWS KMS Customer-Managed Key (KYOK).

Parameters:
  EnvironmentName:
    Type: String
    Default: prod
    AllowedValues: [dev, staging, prod]
    Description: Deployment stage for SLTMobitel AI Platform.
  KBAuthSecretHeaderValue:
    Type: String
    NoEcho: true
    Default: "REPLACE_WITH_SLT_KB_AUTH_SECRET"
    Description: Shared secret validated via the custom origin HTTP header.
  BedrockModelId:
    Type: String
    Default: "anthropic.claude-3-haiku-20240307-v1:0"
    Description: Default Amazon Bedrock foundation model ID for RAG synthesis.

Resources:
  # 1. Sovereign Key Management (Keep Your Own Key - KYOK via AWS KMS)
  SLTSovereignKMSKey:
    Type: AWS::KMS::Key
    Properties:
      Description: SLTMobitel Customer-Managed KMS Key for KnowledgeBase & Audit Log Encryption
      EnableKeyRotation: true
      KeyPolicy:
        Version: "2012-10-17"
        Statement:
          - Sid: AllowRootAccountAdministration
            Effect: Allow
            Principal:
              AWS: !Sub "arn:aws:iam::${AWS::AccountId}:root"
            Action: "kms:*"
            Resource: "*"

  # 2. Encrypted S3 Bucket for Approved SOP Manuals & Immutable Audit Logs
  SLTKnowledgeAndAuditBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: aws:kms
              KMSMasterKeyID: !GetAtt SLTSovereignKMSKey.Arn
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # 3. IAM Execution Role for Lambda Retrieval & Bedrock Synthesis
  SLTAgentLambdaExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: SLTBedrockAndKBAccessPolicy
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action:
                  - bedrock:InvokeModel
                  - bedrock:Retrieve
                  - bedrock:RetrieveAndGenerate
                Resource: "*"
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                Resource: !Sub "${SLTKnowledgeAndAuditBucket.Arn}/*"
              - Effect: Allow
                Action:
                  - logs:CreateLogGroup
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                Resource: "*"

  # 4. AWS Lambda Function for /prod/retrieve KnowledgeBase Endpoint
  SLTKnowledgeRetrieveFunction:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub "slt-mobitel-kb-retrieve-${EnvironmentName}"
      Runtime: python3.11
      Handler: index.handler
      Role: !GetAtt SLTAgentLambdaExecutionRole.Arn
      Timeout: 15
      MemorySize: 512
      Environment:
        Variables:
          EXPECTED_AUTH_SECRET: !Ref KBAuthSecretHeaderValue
          BEDROCK_MODEL_ID: !Ref BedrockModelId
      Code:
        ZipFile: |
          import json
          import os

          def handler(event, context):
              headers = {k.lower(): v for k, v in (event.get("headers") or {}).items()}
              expected = os.environ.get("EXPECTED_AUTH_SECRET", "")
              if headers.get("x-auth-secret") != expected:
                  return {"statusCode": 401, "body": json.dumps({"error": "Unauthorized: invalid x-auth-secret"})}
              body = json.loads(event.get("body") or "{}")
              query = body.get("query", "")
              top_k = min(max(int(body.get("top_k", 3)), 1), 5)
              return {
                  "statusCode": 200,
                  "headers": {"Content-Type": "application/json"},
                  "body": json.dumps({"query": query, "chunks": [], "count": 0, "top_k": top_k})
              }

  # 5. Amazon API Gateway HTTP API (Matches https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/retrieve)
  SLTKnowledgeHttpApi:
    Type: AWS::ApiGatewayV2::Api
    Properties:
      Name: !Sub "sltmobitel-kb-http-api-${EnvironmentName}"
      ProtocolType: HTTP
      CorsConfiguration:
        AllowOrigins:
          - "*"
        AllowMethods:
          - GET
          - POST
          - OPTIONS
        AllowHeaders:
          - Content-Type
          - Authorization
          - x-auth-secret
          - X-Amz-Date
          - X-Api-Key

  SLTKnowledgeApiIntegration:
    Type: AWS::ApiGatewayV2::Integration
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      IntegrationType: AWS_PROXY
      IntegrationUri: !GetAtt SLTKnowledgeRetrieveFunction.Arn
      PayloadFormatVersion: "2.0"

  SLTKnowledgeRetrieveRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      RouteKey: "POST /retrieve"
      Target: !Sub "integrations/${SLTKnowledgeApiIntegration}"

  # 5B. AWS Lambda Serverless Unified Agent Function (Chat, SOP Triage & MCP Server)
  SLTUnifiedAgentLambdaFunction:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub "slt-mobitel-unified-agent-${EnvironmentName}"
      Runtime: python3.11
      Handler: api.lambda_function.lambda_handler
      Role: !GetAtt SLTAgentLambdaExecutionRole.Arn
      Timeout: 30
      MemorySize: 1024
      Environment:
        Variables:
          AI_INFERENCE_MODE: AWS_BEDROCK
          AWS_BEDROCK_MODEL_ID: !Ref BedrockModelId
          SLT_AUDIT_LOG_PATH: /tmp/audit_trail.jsonl
      Code:
        S3Bucket: !Ref SLTKnowledgeAndAuditBucket
        S3Key: deployments/slt-unified-agent.zip

  SLTUnifiedAgentApiIntegration:
    Type: AWS::ApiGatewayV2::Integration
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      IntegrationType: AWS_PROXY
      IntegrationUri: !GetAtt SLTUnifiedAgentLambdaFunction.Arn
      PayloadFormatVersion: "2.0"

  SLTAgentChatRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      RouteKey: "POST /chat"
      Target: !Sub "integrations/${SLTUnifiedAgentApiIntegration}"

  SLTAgentMCPRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      RouteKey: "POST /mcp"
      Target: !Sub "integrations/${SLTUnifiedAgentApiIntegration}"

  SLTAgentVoiceRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      RouteKey: "POST /voice"
      Target: !Sub "integrations/${SLTUnifiedAgentApiIntegration}"

  SLTAgentHealthRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      RouteKey: "GET /health"
      Target: !Sub "integrations/${SLTUnifiedAgentApiIntegration}"

  SLTAgentLambdaApiPermission:
    Type: AWS::Lambda::Permission
    Properties:
      FunctionName: !Ref SLTUnifiedAgentLambdaFunction
      Action: lambda:InvokeFunction
      Principal: apigateway.amazonaws.com
      SourceArn: !Sub "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${SLTKnowledgeHttpApi}/*/*"

  SLTKnowledgeApiStage:
    Type: AWS::ApiGatewayV2::Stage
    Properties:
      ApiId: !Ref SLTKnowledgeHttpApi
      StageName: !Ref EnvironmentName
      AutoDeploy: true
      DefaultRouteSettings:
        ThrottlingBurstLimit: 500
        ThrottlingRateLimit: 1000

  # 5C. High-Scale DynamoDB Tables (On-Demand Pay-Per-Request + KMS Encrypted + TTL)
  SLTFaultTicketsTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub "slt-fault-tickets-${EnvironmentName}"
      BillingMode: PAY_PER_REQUEST
      PointInTimeRecoverySpecification:
        PointInTimeRecoveryEnabled: true
      SSESpecification:
        SSEEnabled: true
        SSEType: KMS
        KMSMasterKeyId: !Ref SLTSovereignKMSKey
      AttributeDefinitions:
        - AttributeName: ticket_id
          AttributeType: S
        - AttributeName: account_id
          AttributeType: S
        - AttributeName: assigned_officer
          AttributeType: S
        - AttributeName: status
          AttributeType: S
      KeySchema:
        - AttributeName: ticket_id
          KeyType: HASH
      GlobalSecondaryIndexes:
        - IndexName: AccountTicketsIndex
          KeySchema:
            - AttributeName: account_id
              KeyType: HASH
          Projection:
            ProjectionType: ALL
        - IndexName: OfficerWorkloadIndex
          KeySchema:
            - AttributeName: assigned_officer
              KeyType: HASH
            - AttributeName: status
              KeyType: RANGE
          Projection:
            ProjectionType: ALL

  SLTOtpAndSessionsTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub "slt-otp-sessions-${EnvironmentName}"
      BillingMode: PAY_PER_REQUEST
      SSESpecification:
        SSEEnabled: true
        SSEType: KMS
        KMSMasterKeyId: !Ref SLTSovereignKMSKey
      TimeToLiveSpecification:
        AttributeName: expires_at
        Enabled: true
      AttributeDefinitions:
        - AttributeName: session_key
          AttributeType: S
      KeySchema:
        - AttributeName: session_key
          KeyType: HASH

  # 5D. AWS WAFv2 WebACL (DDoS / SMS-Pumping Rate Limit + OWASP Managed Rules)
  SLTCloudFrontWebACL:
    Type: AWS::WAFv2::WebACL
    Properties:
      Name: !Sub "sltmobitel-ai-waf-${EnvironmentName}"
      Scope: CLOUDFRONT
      DefaultAction:
        Allow: {}
      VisibilityConfig:
        SampledRequestsEnabled: true
        CloudWatchMetricsEnabled: true
        MetricName: !Sub "SLTMobitelAIWAF-${EnvironmentName}"
      Rules:
        - Name: RateLimitPerIP
          Priority: 1
          Action:
            Block: {}
          Statement:
            RateBasedStatement:
              Limit: 1000
              AggregateKeyType: IP
          VisibilityConfig:
            SampledRequestsEnabled: true
            CloudWatchMetricsEnabled: true
            MetricName: RateLimitPerIP
        - Name: AWSManagedRulesCommonRuleSet
          Priority: 2
          OverrideAction:
            None: {}
          Statement:
            ManagedRuleGroupStatement:
              VendorName: AWS
              Name: AWSManagedRulesCommonRuleSet
          VisibilityConfig:
            SampledRequestsEnabled: true
            CloudWatchMetricsEnabled: true
            MetricName: AWSManagedRulesCommonRuleSet
        - Name: AWSManagedRulesKnownBadInputsRuleSet
          Priority: 3
          OverrideAction:
            None: {}
          Statement:
            ManagedRuleGroupStatement:
              VendorName: AWS
              Name: AWSManagedRulesKnownBadInputsRuleSet
          VisibilityConfig:
            SampledRequestsEnabled: true
            CloudWatchMetricsEnabled: true
            MetricName: AWSManagedRulesKnownBadInputsRuleSet

  # 6. Amazon CloudFront Security Response Headers Policy (HSTS, XSS, No-Sniff, Frame-Options)
  SLTCloudFrontSecurityHeadersPolicy:
    Type: AWS::CloudFront::ResponseHeadersPolicy
    Properties:
      ResponseHeadersPolicyConfig:
        Name: !Sub "sltmobitel-ai-security-headers-${EnvironmentName}"
        Comment: Enforces strict HTTPS HSTS, Content-Type nosniff, and XSS protection at CloudFront Edge
        SecurityHeadersConfig:
          StrictTransportSecurity:
            AccessControlMaxAgeSec: 31536000
            IncludeSubdomains: true
            Preload: true
            Override: true
          ContentTypeOptions:
            Override: true
          FrameOptions:
            FrameOption: DENY
            Override: true
          XSSProtection:
            ModeBlock: true
            Protection: true
            Override: true

  # 7. Amazon CloudFront Edge Distribution in front of SLTMobitel API Gateway Origin
  SLTCloudFrontDistribution:
    Type: AWS::CloudFront::Distribution
    Properties:
      DistributionConfig:
        Enabled: true
        WebACLId: !GetAtt SLTCloudFrontWebACL.Arn
        Comment: SLTMobitel AI Agent CloudFront Edge Gateway (WAFv2 Protected + Injects x-auth-secret)
        HttpVersion: http2and3
        PriceClass: PriceClass_200 # Includes South Asia / Singapore / Chennai Edge POPs for Sri Lanka
        Origins:
          - Id: SLTKBApiGatewayOrigin
            DomainName: !Sub "${SLTKnowledgeHttpApi}.execute-api.${AWS::Region}.amazonaws.com"
            OriginPath: !Sub "/${EnvironmentName}"
            OriginCustomHeaders:
              - HeaderName: x-auth-secret
                HeaderValue: !Ref KBAuthSecretHeaderValue
            CustomOriginConfig:
              HTTPSPort: 443
              OriginProtocolPolicy: https-only
              OriginSSLProtocols: [TLSv1.2]
        DefaultCacheBehavior:
          TargetOriginId: SLTKBApiGatewayOrigin
          ViewerProtocolPolicy: redirect-to-https
          ResponseHeadersPolicyId: !Ref SLTCloudFrontSecurityHeadersPolicy
          AllowedMethods: [GET, HEAD, OPTIONS, PUT, PATCH, POST, DELETE]
          CachedMethods: [GET, HEAD]
          ForwardedValues:
            QueryString: true
            Headers:
              - Content-Type

Outputs:
  HttpApiRetrieveEndpoint:
    Description: Direct API Gateway HTTP Endpoint for SLTMobitel KB Retrieve
    Value: !Sub "https://${SLTKnowledgeHttpApi}.execute-api.${AWS::Region}.amazonaws.com/${EnvironmentName}/retrieve"
  HttpApiChatEndpoint:
    Description: Serverless Unified AI Agent Chat Endpoint
    Value: !Sub "https://${SLTKnowledgeHttpApi}.execute-api.${AWS::Region}.amazonaws.com/${EnvironmentName}/chat"
  HttpApiMCPEndpoint:
    Description: Model Context Protocol (MCP) JSON-RPC 2.0 Serverless Endpoint
    Value: !Sub "https://${SLTKnowledgeHttpApi}.execute-api.${AWS::Region}.amazonaws.com/${EnvironmentName}/mcp"
  HttpApiHealthEndpoint:
    Description: Serverless AI Agent Health & Diagnostics Check
    Value: !Sub "https://${SLTKnowledgeHttpApi}.execute-api.${AWS::Region}.amazonaws.com/${EnvironmentName}/health"
  CloudFrontEdgeDomain:
    Description: CloudFront Edge Distribution Domain Name
    Value: !GetAtt SLTCloudFrontDistribution.DomainName

