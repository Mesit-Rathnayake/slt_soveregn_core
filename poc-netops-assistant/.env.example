# 1. Default AI Engine Mode: RULE_ENGINE | OLLAMA_LOCAL | GEMINI_CLOUD | IBM_SOVCORE
AI_INFERENCE_MODE=OLLAMA_LOCAL

# 2. Ollama Local Sovereign AI Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# 3. Google Gemini API Settings (For External Provider Benchmarking)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
